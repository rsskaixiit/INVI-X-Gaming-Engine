<Window x:Class="Invix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="INVI X"
        Width="620"
        Height="400"
        MinWidth="560"
        MinHeight="400"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource MonoFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource MagentaBrush}"
            BorderThickness="1"
            Background="{StaticResource BgBrush}"
            TextElement.Foreground="{StaticResource GrayBrush}">
        <Grid Margin="14,9,14,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="TopBar" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="INVI X"
                           Foreground="{StaticResource MagentaBrush}"
                           FontSize="12"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AdminText}"
                               Foreground="{StaticResource GrayBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Content="&#x2013;" Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Content="&#x2715;" Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Close (ESC)" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Logo}"
                       Foreground="{StaticResource MagentaBrush}"
                       FontSize="19"
                       FontWeight="Bold"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,7,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF00C8" BlurRadius="13" ShadowDepth="0" Opacity="0.7" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle}"
                       Foreground="{StaticResource CyanBrush}"
                       FontSize="10.5"
                       Margin="0,7,0,0"
                       HorizontalAlignment="Center" />

            <Border Grid.Row="3" Style="{StaticResource FrameDivider}" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATUS :"
                               Foreground="{StaticResource GrayBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="&#x25CF;"
                               Foreground="{Binding StatusBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF00FF41" BlurRadius="11" ShadowDepth="0" Opacity="0.85" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StepSummary}"
                           Foreground="{StaticResource CyanBrush}"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <Border Grid.Row="5" Style="{StaticResource Divider}" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Foreground="{StaticResource CyanBrush}" FontSize="11" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuValue}" Foreground="{StaticResource ValueBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="RAM" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="0,3,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RamValue}" Foreground="{StaticResource ValueBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="0,3,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GpuValue}" Foreground="{StaticResource ValueBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuValue}" />
            </Grid>

            <Border Grid.Row="7" Style="{StaticResource Divider}" />

            <StackPanel Grid.Row="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="F6" Foreground="{StaticResource MagentaBrush}" FontSize="10.5" FontWeight="Bold" />
                        <TextBlock Text="  TOGGLE GAMING MODE" Foreground="{StaticResource GrayBrush}" FontSize="10.5" />
                        <TextBlock Text="   " Foreground="{StaticResource GrayBrush}" FontSize="10.5" />
                        <TextBlock Text="ESC" Foreground="{StaticResource MagentaBrush}" FontSize="10.5" FontWeight="Bold" />
                        <TextBlock Text="  EXIT PANEL" Foreground="{StaticResource GrayBrush}" FontSize="10.5" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{Binding LogToggleLabel}"
                            Command="{Binding ToggleLogCommand}"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Show or hide the operations log" />
                </Grid>

                <WrapPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button Content="APPLY" Command="{Binding ApplyCommand}" Style="{StaticResource TerminalButton}"
                            ToolTip="Apply the INVI X gaming profile (F6)" />
                    <Button Content="REVERT" Command="{Binding RevertCommand}" Style="{StaticResource TerminalButton}"
                            ToolTip="Restore the exact configuration captured in the last backup" />
                    <Button Content="RESTORE DEFAULTS" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource TerminalButton}"
                            ToolTip="Write documented Windows defaults for every step" />
                    <Button Content="{Binding ElevateLabel}" Command="{Binding ElevateCommand}" Style="{StaticResource TerminalButton}"
                            ToolTip="{Binding ElevateTooltip}" />
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="11"
                    Height="150"
                    Margin="0,10,0,0"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBrush}"
                    Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="OPERATIONS LOG"
                                   Foreground="{StaticResource GrayBrush}"
                                   FontSize="10"
                                   Margin="8,5,0,0"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding TweakRows}"
                                      Margin="12,5,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="Per-step status: [ OK ] applied, [REV ] reverted, [DEF ] restored, [FAIL] failed, [ -- ] pending">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Glyph}"
                                               Foreground="{Binding StatusBrush}"
                                               FontSize="10"
                                               Margin="0,0,5,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource CyanDimBrush}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="10.5"
                             Margin="6,2,4,5"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <Border Grid.Row="10"
                    Margin="0,9,0,0"
                    Padding="9,5"
                    BorderBrush="{StaticResource MagentaDimBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding DevCredit}"
                               Foreground="{StaticResource MagentaBrush}"
                               FontSize="10.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="HELP / SUPPORT"
                               Foreground="{StaticResource GrayBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="YOUTUBE  @invi-xd"
                                Command="{Binding OpenYouTubeCommand}"
                                Style="{StaticResource TerminalButton}"
                                Margin="0,0,8,0"
                                ToolTip="https://www.youtube.com/@invi-xd" />
                        <Button Content="DISCORD  INVI-X"
                                Command="{Binding OpenDiscordCommand}"
                                Style="{StaticResource TerminalButton}"
                                Margin="0"
                                ToolTip="Discord - INVI-XD  (https://discord.gg/T5HzhQTnxe)" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="12" Style="{StaticResource Divider}" />

            <TextBlock Grid.Row="13"
                       Text="{Binding Footer}"
                       Foreground="{StaticResource GrayBrush}"
                       FontSize="10.5"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>